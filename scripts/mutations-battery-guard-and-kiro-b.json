{
  "file": "src-tauri/src/battery_guard.rs",
  "cwd": "src-tauri",
  "targetDir": "D:/nexus-screen-target",
  "testArgs": [
    "--lib",
    "--features",
    "custom-protocol,admin-brain",
    "--",
    "--test-threads=1",
    "battery_guard",
    "the_pretool_hook",
    "agent_hooks::",
